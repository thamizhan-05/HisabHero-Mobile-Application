# ─── HISABHERO PRODUCTION BACKEND ENVIRONMENT CONFIGURATION ────────────────
# Copy this file to .env and configure with your specific environment values.
# NEVER commit the real .env file into version control.

# Application Environment & Server Port
PORT=5000
NODE_ENV=development

# Authentication & JWT Configuration
# Generates signed session tokens (30 days default). Use a secure random 256-bit string in production.
JWT_SECRET=your_jwt_super_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=30d

# Security & Rate Limiting
# Allowed CORS origins (e.g. https://hisabhero.vercel.app or * for all)
CORS_ORIGIN=*
# Sliding-window rate limit window in milliseconds (default: 15 mins)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=15
# Allow demo OTP (656527) strictly in test or demo environments (false in production)
ALLOW_DEMO_OTP=false

# ─── SUPABASE POSTGRESQL (EXCLUSIVE APPLICATION DATABASE) ────────────────────
# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase Service Role Key (for backend server-side privileged queries bypassing RLS)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here
# Supabase Anon Key (for public client API queries)
SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Direct PostgreSQL connection string (for migrations, pg pooling, and DDL execution)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ─── GOOGLE OAUTH ────────────────────────────────────────────────────────────
GOOGLE_WEB_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# ─── AI & DOCUMENT INTELLIGENCE (GOOGLE GEMINI) ──────────────────────────────
# Get from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# ─── EMAIL DISPATCHER (GMAIL SMTP / RESEND) ──────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM="HisabHero" <your-email@gmail.com>
RESEND_API_KEY=re_your_resend_api_key_here

# ─── WHATSAPP AUTOMATION (TWILIO) ───────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
