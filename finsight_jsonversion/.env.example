# ─── HISABHERO PRODUCTION BACKEND ENVIRONMENT CONFIGURATION ────────────────
# Copy this file to .env and configure with your specific environment values.
# NEVER commit the real .env file into version control.

# Application Environment & Server Port
PORT=5000
NODE_ENV=development

# Authentication & JWT Configuration
# Generates signed session tokens (30 days default). Use a secure random 256-bit string in production.
JWT_SECRET=your_jwt_super_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=30d

# Security & Rate Limiting
# Allowed CORS origins (e.g. https://hisabhero.vercel.app or * for all)
CORS_ORIGIN=*
# Sliding-window rate limit window in milliseconds (default: 15 mins)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=15
# Allow demo OTP (656527) strictly in test or demo environments (false in production)
ALLOW_DEMO_OTP=false

# Primary Relational Database (Supabase PostgreSQL 15+)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-service-role-key-here

# Secondary Fallback Database (MongoDB Atlas) - Optional
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/hisabhero?retryWrites=true&w=majority

# AI & Document Intelligence (Google Gemini Vision & Hero Bot)
# Get from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Email Dispatcher (OTP and Notifications via Resend or SMTP) - Optional
RESEND_API_KEY=re_your_resend_api_key_here
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your-smtp-password-here

# WhatsApp Notifications via Twilio - Optional
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=whatsapp:+14155238886
