# HisabHero Backend Environment Configuration Template
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@hisabhero.mongodb.net/hisabhero?retryWrites=true&w=majority

# JWT & Session Security Secrets (Generate a strong random 256-bit secret in production)
JWT_SECRET=your-production-jwt-secret-key-change-this
REFRESH_TOKEN_SECRET=your-production-refresh-token-secret-key-change-this

# Google Gemini API Key (Document Intelligence & AI CFO)
GEMINI_API_KEY=your-google-gemini-api-key

# SMTP & Resend Email Configuration (Verification OTP & Notifications)
RESEND_API_KEY=
EMAIL_FROM=HisabHero <onboarding@resend.dev>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@hisabhero.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM=HisabHero <noreply@hisabhero.com>

