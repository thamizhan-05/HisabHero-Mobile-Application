{
  "expo": {
    "name": "HisabHero",
    "slug": "hisabhero-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "hisabhero",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "image": "./assets/logo.png",
      "backgroundColor": "#06111f",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hisabhero.app",
      "infoPlist": {
        "NSCameraUsageDescription": "HisabHero needs access to your camera to capture receipts for instant AI financial expense extraction.",
        "NSPhotoLibraryUsageDescription": "HisabHero needs access to your photo library to select receipt images for expense extraction."
      }
    },
    "android": {
      "package": "com.hisabhero.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#06111f"
      }
    },
    "newArchEnabled": false,
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "enableMinifyInReleaseBuilds": false,
            "shrinkResourcesInReleaseBuilds": false
          }
        }
      ],
      "expo-secure-store",
      "expo-image-picker",
      "expo-document-picker"
    ],
    "extra": {
      "eas": {
        "projectId": "650b819c-53e8-4407-9851-2a6ed9aaeb0b"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/650b819c-53e8-4407-9851-2a6ed9aaeb0b"
    }
  }
}
